# ─────────────────────────────────────────────────────────────
# AI provider keys — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Read exclusively from src/lib/ai/keys.ts (server-side module).
#
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and never shipped to the client.
# ─────────────────────────────────────────────────────────────

# Google Gemini (comma separated, any number)
GEMINI_API_KEYS=

# Groq (comma separated, any number)
GROQ_API_KEYS=

# OpenRouter (comma separated, any number)
OPENROUTER_API_KEYS=

# ─────────────────────────────────────────────────────────────
# Optional Supabase. Leave blank to run fully local-first.
#
# To switch on the real backend:
#   1. Create a project at supabase.com, then run supabase/schema.sql in the
#      SQL editor. It is the whole snapshot - every table, the RLS policies,
#      the share_links and the push tables. The numbered 0x-*.sql files are the
#      history of how it got there; running schema.sql alone is enough.
#   2. Copy the Project URL and the anon public key from Settings → API into
#      NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY.
#   3. Add <your-domain>/reset-password to Authentication → URL Configuration
#      → Redirect URLs, otherwise the recovery email link bounces.
#   4. SUPABASE_SERVICE_ROLE_KEY is server-only: it moves share links off the
#      local disk into share_links, which is what serverless deploys need.
#      Leave it blank to keep shares in .data/shares/ (single instance only).
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Web Push — SERVER ONLY except NEXT_PUBLIC_VAPID_PUBLIC_KEY.
#
# Reminders that arrive when the app is closed are sent from the server, so they
# need a VAPID key pair. Generate one once and keep it:
#
#   npx web-push generate-vapid-keys
#
# The two halves are not interchangeable: the public key goes to the browser and
# identifies this sender to the push service, and the private key stays here and
# signs every message. Replacing the pair invalidates every subscription ever
# created under it, and every student's reminders stop until they turn the switch
# off and on again — so set it once, then leave it alone.
#
# PUSH_CRON_SECRET is a second, unrelated secret: the header the pg_cron job in
# supabase/09-push-subscriptions.sql identifies itself with, because that job
# cannot sign in as anybody. Same string on both sides. Generate with:
#
#   openssl rand -hex 32
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# AI quota
# ─────────────────────────────────────────────────────────────
# Each AI call spends one of your provider keys, and the keys are server-side, so
# nothing in the app itself stops one person from calling the AI routes in a loop.
# supabase/10-ai-rate-limit.sql adds the counter: one row per user, shared by every
# serverless instance, which an in-memory limit could not be.
#
# Per signed-in user, per hour. The right number depends on whether your keys are
# free or paid - free tiers are already capped by the provider, so this is mainly
# there to stop one person spending everyone else's quota.
#
# Needs SUPABASE_SERVICE_ROLE_KEY above, and the 10-ai-rate-limit.sql migration.
# With no Supabase configured the app runs local-first and no limit is applied.
AI_RATE_LIMIT_PER_HOUR=25

# ─────────────────────────────────────────────────────────────
# Canonical public origin, sent to OpenRouter as the app URL and referrer for
# their free-tier attribution. Only cosmetic — share links use the browser's
# own origin, so nothing breaks when this is empty.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=
